{
  "name": "bifrost-registry-ui",
  "private": true,
  "version": "0.2.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "prototype:model-card": "vite --host 127.0.0.1 --port 8771 --strictPort",
    "prototype:key-composer": "vite --host 127.0.0.1 --port 8772 --strictPort",
    "check:key-composer": "node --import tsx src/experiments/key-composer-prototype/state.test.ts && node --import tsx src/experiments/key-composer-prototype/key-state.test.ts",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write src e2e scripts",
    "format:check": "prettier --check src e2e scripts",
    "check": "node scripts/run-checks.test.mjs && node scripts/run-checks.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.12",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-label": "2.1.16",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-select": "2.3.8",
    "@radix-ui/react-separator": "1.1.16",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-switch": "1.3.8",
    "@radix-ui/react-toggle": "1.1.19",
    "@radix-ui/react-toggle-group": "1.1.20",
    "@radix-ui/react-tooltip": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
