 j.type === 'message')) {","        shape = 'anthropic-messages';","        hasContent = j.content.some(function (c) { return c && (c.type === 'text' && c.text) || c.type === 'tool_use' || c.type === 'server_tool_use'; });","        // Adaptive-thinking models spend output tokens on thinking before any visible block. Sonnet 5 is adaptive-only and rejects thinking:{type:'enabled'}, so there is no budget_tokens knob to turn it down with: under a small max_tokens it can burn the whole cap thinking about a one-word answer and end the turn mid-thinking, which returns stop_reason 'max_tokens' with content []. Tokens were produced and the turn worked, so failing here reports a defect in whatever the row was actually measuring (cache counters, routing) that did not happen. Same forgiveness the openai-chat branch above gives stop-sequence truncation. An empty content array with no output tokens is still a failure.","        if (!hasContent && j.stop_reason === 'max_tokens' && j.usage && j.usage.output_tokens > 0) { hasContent = true; }","    } else if (j.candidates && j.candidates[0] && j.candidates[0].content) {","        shape = 'gemini-generate-content';","        var parts = j.candidates[0].content.parts || [];","        // Image-output models (responseModalities IMAGE) answer with inlineData parts only; the image IS the content.","        hasContent = parts.some(function (p) { return p && (p.text || p.functionCall || p.executableCode || (p.inlineData && p.inlineData.data)); });","    } else if (typeof j.output_text === 'string' && j.output_text.length > 0) {","        shape = 'openai-responses-output_text';","        hasContent = true;","    } else if (Array.isArray(j.output) && j.output.length > 0) {","        shape = 'openai-responses-output';","        // Responses tool-use items are all typed <tool>_call (function_call, tool_search_call, custom_tool_call, mcp_call, local_shell_call, ...). A client-execution call is a valid TERMINAL output: the model emits the call a