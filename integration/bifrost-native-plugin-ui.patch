diff --git a/transports/bifrost-http/server/plugin_ui.go b/transports/bifrost-http/server/plugin_ui.go
new file mode 100644
index 0000000..93199ec
--- /dev/null
+++ b/transports/bifrost-http/server/plugin_ui.go
@@ -0,0 +1,262 @@
+package server
+
+import (
+	"encoding/json"
+	"fmt"
+	"io/fs"
+	"mime"
+	"net/url"
+	"path"
+	"sort"
+	"strings"
+
+	"github.com/maximhq/bifrost/core/schemas"
+	"github.com/maximhq/bifrost/transports/bifrost-http/lib"
+	"github.com/valyala/fasthttp"
+)
+
+// A plugin owns only /plugins/{GetName}/. Names cannot alias a native route or
+// another contribution through normalization.
+func validPluginUIName(name string) bool {
+	if name == "" || name == "." || name == ".." {
+		return false
+	}
+	for _, c := range name {
+		if !((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_') {
+			return false
+		}
+	}
+	return true
+}
+
+func (s *BifrostHTTPServer) preparePluginUI(plugin schemas.BasePlugin) (schemas.PluginAdminUI, error) {
+	provider, ok := plugin.(schemas.AdminUIPlugin)
+	if !ok {
+		return schemas.PluginAdminUI{}, nil
+	}
+	ui, err := provider.GetAdminUI(schemas.PluginAdminUIHost{DataDir: GetDefaultConfigDir(s.AppDir), CallNative: s.callNativePluginAPI})
+	if err != nil {
+		return ui, err
+	}
+	if ui.Assets == nil && ui.API == nil && ui.Title == "" {
+		return ui, nil
+	} // optional .so symbol absent
+	if !validPluginUIName(plugin.GetName()) {
+		return ui, fmt.Errorf("invalid plugin UI name %q", plugin.GetName())
+	}
+	if ui.Title == "" || ui.Assets == nil {
+		return ui, fmt.Errorf("plugin UI requires title and embedded assets")
+	}
+	if _, err := fs.ReadFile(ui.Assets, "index.html"); err != nil {
+		return ui, fmt.Errorf("plugin UI index.html: %w", err)
+	}
+	return ui, nil
+}
+
+func (s *BifrostHTTPServer) setPluginUI(name string, ui schemas.PluginAdminUI) {
+	s.pluginUIMu.Lock()
+	defer s.pluginUIMu.Unlock()
+	if s.pluginUIs == nil {
+		s.pluginUIs = make(map[string]schemas.PluginAdminUI)
+	}
+	if ui.Assets == nil {
+		delete(s.pluginUIs, name)
+	} else {
+		s.pluginUIs[name] = ui
+	}
+}
+
+func (s *BifrostHTTPServer) registerPluginUIRoutes(middlewares ...schemas.BifrostHTTPMiddleware) error {
+	if s.Config != nil {
+		if plugins := s.Config.BasePlugins.Load(); plugins != nil {
+			for _, plugin := range *plugins {
+				ui, err := s.preparePluginUI(plugin)
+				if err != nil {
+					return fmt.Errorf("plugin %s: %w", plugin.GetName(), err)
+				}
+				if ui.Assets != nil {
+					s.pluginUIMu.RLock()
+					_, collision := s.pluginUIs[plugin.GetName()]
+					s.pluginUIMu.RUnlock()
+					if collision {
+						return fmt.Errorf("plugin UI route collision: %s", plugin.GetName())
+					}
+					s.setPluginUI(plugin.GetName(), ui)
+				}
+			}
+		}
+	}
+	if s.AuthMiddleware == nil {
+		return nil
+	}
+	// Keep the regular middleware chain (including enterprise hooks), then
+	// insist on native admin authentication even for a whitelisted path.
+	secured := append(append([]schemas.BifrostHTTPMiddleware(nil), middlewares...), s.AuthMiddleware.PluginAdminUIMiddleware())
+	s.Router.GET("/api/plugin-ui", lib.ChainMiddlewares(s.listPluginUIs, secured...))
+	handler := lib.ChainMiddlewares(s.servePluginUI, secured...)
+	for _, method := range []string{fasthttp.MethodGet, fasthttp.MethodHead, fasthttp.MethodPost, fasthttp.MethodPut, fasthttp.MethodPatch, fasthttp.MethodDelete} {
+		s.Router.Handle(method, "/plugins/{name}/", handler)
+		s.Router.Handle(method, "/plugins/{name}/{filepath:*}", handler)
+	}
+	return nil
+}
+
+func (s *BifrostHTTPServer) listPluginUIs(ctx *fasthttp.RequestCtx) {
+	if bypassed, _ := ctx.UserValue(schemas.BifrostContextKeyAuthBypassed).(bool); bypassed {
+		ctx.Error("Authentication required", fasthttp.StatusForbidden)
+		return
+	}
+	type item struct {
+		Name  string `json:"name"`
+		Title string `json:"title"`
+		URL   string `json:"url"`
+	}
+	s.pluginUIMu.RLock()
+	list := make([]item, 0, len(s.pluginUIs))
+	for name, ui := range s.pluginUIs {
+		list = append(list, item{name, ui.Title, "/plugins/" + name + "/"})
+	}
+	s.pluginUIMu.RUnlock()
+	sort.Slice(list, func(i, j int) bool { return list[i].Name < list[j].Name })
+	body, _ := json.Marshal(list)
+	ctx.SetContentType("application/json")
+	ctx.Response.Header.Set("Cache-Control", "no-store")
+	ctx.SetBody(body)
+}
+
+func samePluginUIOrigin(ctx *fasthttp.RequestCtx) bool {
+	site := string(ctx.Request.Header.Peek("Sec-Fetch-Site"))
+	if site == "cross-site" || site == "same-site" {
+		return false
+	}
+	origin := string(ctx.Request.Header.Peek("Origin"))
+	if origin == "" {
+		return true
+	}
+	parsed, err := url.Parse(origin)
+	scheme := "http"
+	if ctx.IsTLS() || string(ctx.Request.Header.Peek("X-Forwarded-Proto")) == "https" {
+		scheme = "https"
+	}
+	return err == nil && parsed.Scheme == scheme && parsed.Host == string(ctx.Host()) && parsed.User == nil && parsed.RawQuery == "" && parsed.Fragment == "" && parsed.Path == ""
+}
+
+func (s *BifrostHTTPServer) servePluginUI(ctx *fasthttp.RequestCtx) {
+	if bypassed, _ := ctx.UserValue(schemas.BifrostContextKeyAuthBypassed).(bool); bypassed {
+		ctx.Error("Authentication required", fasthttp.StatusForbidden)
+		return
+	}
+	if !samePluginUIOrigin(ctx) {
+		ctx.Error("Forbidden", fasthttp.StatusForbidden)
+		return
+	}
+	name, _ := ctx.UserValue("name").(string)
+	s.pluginUIMu.RLock()
+	ui, ok := s.pluginUIs[name]
+	defer s.pluginUIMu.RUnlock()
+	if !ok {
+		ctx.Error("Plugin UI not found", fasthttp.StatusNotFound)
+		return
+	}
+	raw := strings.SplitN(string(ctx.RequestURI()), "?", 2)[0]
+	decoded, err := url.PathUnescape(raw)
+	if err != nil || strings.Contains(decoded, "\\") {
+		ctx.Error("Invalid path", fasthttp.StatusBadRequest)
+		return
+	}
+	for _, part := range strings.Split(decoded, "/") {
+		if part == ".." {
+			ctx.Error("Invalid path", fasthttp.StatusBadRequest)
+			return
+		}
+	}
+	prefix := "/plugins/" + name + "/"
+	if !strings.HasPrefix(decoded, prefix) {
+		ctx.Error("Invalid path", fasthttp.StatusBadRequest)
+		return
+	}
+	relative := strings.TrimPrefix(decoded, prefix)
+	if relative == "api" || strings.HasPrefix(relative, "api/") {
+		if ui.API == nil {
+			ctx.Error("Not found", fasthttp.StatusNotFound)
+			return
+		}
+		if len(ctx.Request.Body()) > 4<<20 {
+			ctx.Error("Request too large", fasthttp.StatusRequestEntityTooLarge)
+			return
+		}
+		original := string(ctx.Path())
+		ctx.Request.URI().SetPath("/" + relative)
+		defer ctx.Request.URI().SetPath(original)
+		ui.API(ctx)
+		return
+	}
+	if string(ctx.Method()) != fasthttp.MethodGet && string(ctx.Method()) != fasthttp.MethodHead {
+		ctx.Error("Method not allowed", fasthttp.StatusMethodNotAllowed)
+		return
+	}
+	asset := relative
+	if asset == "" {
+		asset = "index.html"
+	}
+	if !fs.ValidPath(asset) || path.Clean(asset) != asset {
+		ctx.Error("Invalid path", fasthttp.StatusBadRequest)
+		return
+	}
+	body, err := fs.ReadFile(ui.Assets, asset)
+	if err != nil && !strings.Contains(path.Base(asset), ".") {
+		asset = "index.html"
+		body, err = fs.ReadFile(ui.Assets, asset)
+	}
+	if err != nil {
+		ctx.Error("Not found", fasthttp.StatusNotFound)
+		return
+	}
+	contentType := mime.TypeByExtension(path.Ext(asset))
+	if contentType == "" {
+		contentType = "application/octet-stream"
+	}
+	ctx.SetContentType(contentType)
+	ctx.Response.Header.Set("Cache-Control", "no-store")
+	ctx.Response.Header.Set("X-Content-Type-Options", "nosniff")
+	if asset == "index.html" {
+		ctx.Response.Header.Set("Content-Security-Policy", "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'none'; frame-ancestors 'none'")
+	}
+	if string(ctx.Method()) != fasthttp.MethodHead {
+		ctx.SetBody(body)
+	}
+}
+
+// callNativePluginAPI dispatches through the real router and auth middleware.
+// The child context is request-scoped; plugin code must not retain it.
+func (s *BifrostHTTPServer) callNativePluginAPI(parent *fasthttp.RequestCtx, req *fasthttp.Request, resp *fasthttp.Response) {
+	childPath := string(req.URI().Path())
+	// A plugin API request holds the UI read lock. Avoid reentering plugin
+	// lifecycle handlers, which take its write lock.
+	if strings.HasPrefix(childPath, "/api/plugins") || (childPath == "/api/config" && string(req.Header.Method()) != fasthttp.MethodGet) {
+		resp.SetStatusCode(fasthttp.StatusForbidden)
+		return
+	}
+	if !(strings.HasPrefix(childPath, "/api/") && childPath != "/api/plugin-ui" || childPath == "/v1/models" || childPath == "/openai/v1/models") {
+		resp.SetStatusCode(fasthttp.StatusForbidden)
+		return
+	}
+	var childRequest fasthttp.Request
+	req.CopyTo(&childRequest)
+	childRequest.Header.SetHost(string(parent.Host()))
+	if len(childRequest.Header.Peek("Authorization")) == 0 && childPath != "/v1/models" && childPath != "/openai/v1/models" {
+		childRequest.Header.SetBytesV("Authorization", parent.Request.Header.Peek("Authorization"))
+	}
+	if len(childRequest.Header.Peek("Cookie")) == 0 && childPath != "/v1/models" && childPath != "/openai/v1/models" {
+		childRequest.Header.SetBytesV("Cookie", parent.Request.Header.Peek("Cookie"))
+	}
+	for _, header := range []string{"Origin", "Sec-Fetch-Site", "X-Forwarded-Proto"} {
+		if len(childRequest.Header.Peek(header)) == 0 {
+			childRequest.Header.SetBytesV(header, parent.Request.Header.Peek(header))
+		}
+	}
+	var childCtx fasthttp.RequestCtx
+	childCtx.Init(&childRequest, parent.RemoteAddr(), nil)
+	s.Router.Handler(&childCtx)
+	childCtx.Response.CopyTo(resp)
+}
diff --git a/transports/bifrost-http/server/plugin_ui_test.go b/transports/bifrost-http/server/plugin_ui_test.go
