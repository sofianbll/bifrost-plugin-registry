index 0000000..ed20f50
--- /dev/null
+++ b/transports/bifrost-http/server/plugin_ui_test.go
@@ -0,0 +1,161 @@
+package server
+
+import (
+	"errors"
+	"io/fs"
+	"testing"
+	"testing/fstest"
+
+	"github.com/fasthttp/router"
+	"github.com/maximhq/bifrost/core/schemas"
+	"github.com/maximhq/bifrost/transports/bifrost-http/handlers"
+	"github.com/maximhq/bifrost/transports/bifrost-http/lib"
+	"github.com/valyala/fasthttp"
+)
+
+func TestPluginUIRouteRegistration(t *testing.T) {
+	s := &BifrostHTTPServer{Router: router.New(), AuthMiddleware: &handlers.AuthMiddleware{}}
+	if err := s.registerPluginUIRoutes(); err != nil {
+		t.Fatal(err)
+	}
+	// The router aliases the wildcard root to the slashless path. The handler
+	// must canonicalize it without registering a duplicate explicit route.
+	routes := router.New()
+	routes.GET("/plugins/{name}/", s.servePluginUI)
+	routes.GET("/plugins/{name}/{filepath:*}", s.servePluginUI)
+	s.setPluginUI("demo", schemas.PluginAdminUI{Title: "Demo", Assets: fstest.MapFS{"index.html": &fstest.MapFile{Data: []byte("ok")}}})
+	ctx := pluginUIRequest("/plugins/demo", "GET", "")
+	routes.Handler(ctx)
+	if ctx.Response.StatusCode() != 301 || string(ctx.Response.Header.Peek("Location")) != "http://localhost:8080/plugins/demo/" {
+		t.Fatalf("slashless route = %d %q", ctx.Response.StatusCode(), ctx.Response.Header.Peek("Location"))
+	}
+}
+
+type failingUIPlugin struct{}
+
+func (failingUIPlugin) GetName() string { return "demo" }
+func (failingUIPlugin) Cleanup() error  { return nil }
+func (failingUIPlugin) GetAdminUI(schemas.PluginAdminUIHost) (schemas.PluginAdminUI, error) {
+	return schemas.PluginAdminUI{}, errors.New("broken assets")
+}
+
+func TestFailedReloadRemovesPreviousUI(t *testing.T) {
+	s := &BifrostHTTPServer{Config: &lib.Config{}}
+	s.setPluginUI("demo", schemas.PluginAdminUI{Title: "Old", Assets: fstest.MapFS{"index.html": &fstest.MapFile{Data: []byte("old")}}})
+	if err := s.SyncLoadedPlugin(nil, "demo", failingUIPlugin{}, nil, nil); err == nil {
+		t.Fatal("broken UI loaded")
+	}
+	ctx := pluginUIRequest("/plugins/demo/", "GET", "")
+	s.servePluginUI(ctx)
+	if ctx.Response.StatusCode() != 404 {
+		t.Fatalf("stale UI after reload failure: %d", ctx.Response.StatusCode())
+	}
+}
+
+func TestPluginUINameCollisionKeepsOwner(t *testing.T) {
+	config := &lib.Config{}
+	if err := config.ReloadPlugin(failingUIPlugin{}); err != nil {
+		t.Fatal(err)
+	}
+	config.UpdatePluginOverallStatus("demo", "first", schemas.PluginStatusActive, nil, nil)
+	s := &BifrostHTTPServer{Config: config}
+	s.setPluginUI("demo", schemas.PluginAdminUI{Title: "First", Assets: fstest.MapFS{"index.html": &fstest.MapFile{Data: []byte("first")}}})
+	if err := s.SyncLoadedPlugin(nil, "second", failingUIPlugin{}, nil, nil); err == nil {
+		t.Fatal("duplicate plugin name accepted")
+	}
+	ctx := pluginUIRequest("/plugins/demo/", "GET", "")
+	s.servePluginUI(ctx)
+	if ctx.Response.StatusCode() != 200 || string(ctx.Response.Body()) != "first" {
+		t.Fatalf("collision replaced owner: %d %q", ctx.Response.StatusCode(), ctx.Response.Body())
+	}
+}
+
+func pluginUIRequest(uri, method, origin string) *fasthttp.RequestCtx {
+	var request fasthttp.Request
+	request.SetRequestURI(uri)
+	request.Header.SetMethod(method)
+	request.Header.SetHost("localhost:8080")
+	if origin != "" {
+		request.Header.Set("Origin", origin)
+	}
+	ctx := &fasthttp.RequestCtx{}
+	ctx.Init(&request, nil, nil)
+	ctx.SetUserValue("name", "demo")
+	return ctx
+}
+
+func TestPluginUIBoundariesAndLifecycle(t *testing.T) {
+	s := &BifrostHTTPServer{}
+	assets := fstest.MapFS{"index.html": &fstest.MapFile{Data: []byte("<h1>demo</h1>")}, "assets/app.js": &fstest.MapFile{Data: []byte("ok")}}
+	s.setPluginUI("demo", schemas.PluginAdminUI{Title: "Demo", Assets: fs.FS(assets)})
+	for _, tc := range []struct {
+		uri, method, origin string
+		status              int
+	}{
+		{"/plugins/demo/", "GET", "", 200},
+		{"/plugins/demo/assets/app.js", "GET", "", 200},
+		{"/plugins/demo/%2e%2e/secret", "GET", "", 400},
+		{"/plugins/demo/assets/missing.js", "GET", "", 404},
+		{"/plugins/demo/", "PUT", "http://evil.example", 403},
+	} {
+		ctx := pluginUIRequest(tc.uri, tc.method, tc.origin)
+		s.servePluginUI(ctx)
+		if got := ctx.Response.StatusCode(); got != tc.status {
+			t.Fatalf("%s: got %d want %d", tc.uri, got, tc.status)
+		}
+	}
+	s.setPluginUI("demo", schemas.PluginAdminUI{})
+	ctx := pluginUIRequest("/plugins/demo/", "GET", "")
+	s.servePluginUI(ctx)
+	if ctx.Response.StatusCode() != 404 {
+		t.Fatalf("disabled UI status = %d", ctx.Response.StatusCode())
+	}
+	s.setPluginUI("demo", schemas.PluginAdminUI{Title: "Demo", Assets: fs.FS(assets)})
+	ctx = pluginUIRequest("/plugins/demo/", "GET", "")
+	s.servePluginUI(ctx)
+	if ctx.Response.StatusCode() != 200 {
+		t.Fatalf("reactivated UI status = %d", ctx.Response.StatusCode())
+	}
+	if validPluginUIName("../demo") || validPluginUIName("API") || !validPluginUIName("demo-2") {
+		t.Fatal("unsafe UI name accepted")
+	}
+}
+
+func TestPluginUINativeCallUsesCurrentSessionAndExplicitVK(t *testing.T) {
+	s := &BifrostHTTPServer{Router: router.New()}
+	s.Router.GET("/api/config", func(ctx *fasthttp.RequestCtx) {
+		if string(ctx.Request.Header.Cookie("token")) != "session" {
+			ctx.Error("no session", 401)
+			return
+		}
+		ctx.SetBodyString("ok")
+	})
+	s.Router.GET("/v1/models", func(ctx *fasthttp.RequestCtx) {
+		ctx.SetBody(ctx.Request.Header.Peek("Authorization"))
+	})
+	parent := pluginUIRequest("/plugins/demo/api/workspace", "GET", "http://localhost:8080")
+	parent.Request.Header.SetCookie("token", "session")
+	parent.Request.Header.Set("Authorization", "Bearer admin")
+	var req fasthttp.Request
+	var resp fasthttp.Response
+	req.SetRequestURI("/api/config")
+	s.callNativePluginAPI(parent, &req, &resp)
+	if resp.StatusCode() != 200 {
+		t.Fatalf("session call = %d", resp.StatusCode())
+	}
+	req.Reset()
+	resp.Reset()
+	req.SetRequestURI("/v1/models")
+	req.Header.Set("Authorization", "Bearer sk-bf-vk")
+	s.callNativePluginAPI(parent, &req, &resp)
+	if string(resp.Body()) != "Bearer sk-bf-vk" {
+		t.Fatalf("VK overwritten: %q", resp.Body())
+	}
+	req.Reset()
+	resp.Reset()
+	req.SetRequestURI("/plugins/demo/")
+	s.callNativePluginAPI(parent, &req, &resp)
+	if resp.StatusCode() != 403 {
+		t.Fatalf("recursive native call = %d", resp.StatusCode())
+	}
+}
