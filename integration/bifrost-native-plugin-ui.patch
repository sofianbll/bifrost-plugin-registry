+package schemas
+
+import (
+	"io/fs"
+
+	"github.com/valyala/fasthttp"
+)
+
+// PluginAdminUIHost supplies the native services available to an authenticated
+// plugin page. CallNative keeps the current browser session for /api requests;
+// an explicit Authorization header may be used for /v1/models readback.
+type PluginAdminUIHost struct {
+	DataDir    string
+	CallNative func(parent *fasthttp.RequestCtx, req *fasthttp.Request, resp *fasthttp.Response)
+}
+
+// PluginAdminUI is an optional same-origin UI contribution. Assets is rooted
+// at index.html; API handles paths beginning with /api/.
+type PluginAdminUI struct {
+	Title  string
+	Assets fs.FS
+	API    fasthttp.RequestHandler
+}
+
+type AdminUIPlugin interface {
+	GetAdminUI(host PluginAdminUIHost) (PluginAdminUI, error)
+}
