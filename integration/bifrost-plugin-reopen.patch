+// plugin.Open caches by filename for the lifetime of the process. URL downloads
+// have a new filename each time, so remember their loaded module by content.
+// ponytail: one process-wide lock serializes plugin.Open; split it if plugin-load throughput matters.
+var openedSharedObjects = struct {
+	sync.Mutex
+	byDigest map[[sha256.Size]byte]*plugin.Plugin
+	bySource map[string][sha256.Size]byte
+}{
+	byDigest: make(map[[sha256.Size]byte]*plugin.Plugin),
+	bySource: make(map[string][sha256.Size]byte),
+}
+
+func pluginDigest(path string) ([sha256.Size]byte, error) {
+	file, err := os.Open(path)
+	if err != nil {
+		return [sha256.Size]byte{}, err
+	}
+	defer file.Close()
+	hash := sha256.New()
+	if _, err := io.Copy(hash, file); err != nil {
+		return [sha256.Size]byte{}, err
+	}
+	var digest [sha256.Size]byte
+	copy(digest[:], hash.Sum(nil))
+	return digest, nil
+}
