+
+func TestSharedObjectPluginLoader_ReusesDownloadedPlugin(t *testing.T) {
+	pluginPath := filepath.Join(t.TempDir(), "hello-world.so")
+	source := filepath.Join(t.TempDir(), "main.go")
+	require.NoError(t, os.WriteFile(source, []byte("package main\nfunc GetName() string { return \"hello-world\" }\nfunc Cleanup() error { return nil }\n"), 0600))
+	build := exec.Command("go", "build", "-buildmode=plugin", "-o", pluginPath, source)
+	build.Env = append(os.Environ(), "CGO_ENABLED=1", "GOWORK=off")
+	output, err := build.CombinedOutput()
+	require.NoError(t, err, string(output))
+	payload, err := os.ReadFile(pluginPath)
+	require.NoError(t, err)
+	var gets atomic.Int32
+	var changed atomic.Bool
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gets.Add(1)
+		if changed.Load() {
+			_, _ = w.Write(append(payload, 0))
+			return
+		}
+		_, _ = w.Write(payload)
+	}))
+	defer server.Close()
+	u, err := url.Parse(server.URL)
+	require.NoError(t, err)
+	allow, err := network.NewAllowlist([]string{u.Hostname()})
+	require.NoError(t, err)
+	loader := NewSharedObjectPluginLoader(allow)
+	pluginURL := server.URL + "/hello-world.so"
+
+	for i := range 2 {
+		loaded, err := loader.LoadPlugin(pluginURL, map[string]any{"attempt": i})
+		require.NoError(t, err)
+		assert.Equal(t, "hello-world", loaded.GetName())
+	}
+	assert.EqualValues(t, 2, gets.Load(), "each load must re-download through the protected client")
+
+	changed.Store(true)
+	_, err = loader.LoadPlugin(pluginURL, nil)
+	require.ErrorContains(t, err, "restart required")
+	assert.EqualValues(t, 3, gets.Load())
+}
